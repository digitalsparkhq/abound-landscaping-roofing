---
// src/layouts/Layout.astro
import '../styles/global.css';
import Header from '../components/Header.astro';
// 1. Import the new Footer component here
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Expert garden care, lawn mowing, and hedge maintenance in Harlow & Essex. Quality, reliable service to make your garden thrive." 
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} | HB Gardencare</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body class="font-sans text-gray-800 bg-brand-light antialiased flex flex-col min-h-screen">
    
    <Header />

    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
    
  </body>
</html>