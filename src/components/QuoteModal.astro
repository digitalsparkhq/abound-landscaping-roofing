---
// src/components/QuoteModal.astro
---

<dialog id="quote-modal" class="backdrop:bg-black/60 p-0 rounded-lg shadow-2xl m-auto max-w-2xl w-full border-none">
  <div class="bg-white p-6 md:p-8 relative">
    <button id="close-modal" class="absolute top-4 right-4 text-gray-500 hover:text-brand-accent focus:outline-none transition-colors cursor-pointer">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
    
    <h2 class="text-2xl font-bold text-brand-green mb-2">Get a Quick Quote</h2>
    <p class="text-gray-600 mb-6">Fill out the details below. This will open a direct WhatsApp chat with our team so we can arrange your quote instantly.</p>

    <form id="whatsapp-quote-form" class="space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700">Name</label>
          <input type="text" id="wa-name" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green focus:ring-brand-green p-2.5 border bg-gray-50 focus:bg-white transition-colors" required />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Phone Number</label>
          <input type="tel" id="wa-phone" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green focus:ring-brand-green p-2.5 border bg-gray-50 focus:bg-white transition-colors" required />
        </div>
        <div class="md:col-span-2">
          <label class="block text-sm font-medium text-gray-700">Address Line 1</label>
          <input type="text" id="wa-address1" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green focus:ring-brand-green p-2.5 border bg-gray-50 focus:bg-white transition-colors" required />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Address Line 2 (Optional)</label>
          <input type="text" id="wa-address2" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green focus:ring-brand-green p-2.5 border bg-gray-50 focus:bg-white transition-colors" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Postal Code</label>
          <input type="text" id="wa-postcode" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green focus:ring-brand-green p-2.5 border bg-gray-50 focus:bg-white transition-colors" required />
        </div>
      </div>

      <hr class="border-gray-200" />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700">Service Required</label>
          <select id="wa-service" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green focus:ring-brand-green p-2.5 border bg-gray-50 focus:bg-white transition-colors cursor-pointer">
            <option>Roof & Gutter Cleaning</option>
            <option>Patio Restoration / Jet Wash</option>
            <option>Garden Transformation</option>
            <option>Fencing & Gates</option>
            <option>Turfing & Lawns</option>
            <option>Other / 10% New Customer Discount</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700">Ideal Start Date</label>
          <select id="wa-date" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green focus:ring-brand-green p-2.5 border bg-gray-50 focus:bg-white transition-colors cursor-pointer">
            <option>As soon as possible</option>
            <option>Within the next week</option>
            <option>Within the next month</option>
            <option>Flexible</option>
          </select>
        </div>
        <div class="md:col-span-2">
          <label class="block text-sm font-medium text-gray-700">Project Description</label>
          <textarea id="wa-desc" rows="3" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green focus:ring-brand-green p-2.5 border bg-gray-50 focus:bg-white transition-colors" placeholder="Tell us about the property or issue..."></textarea>
        </div>
      </div>

      <button type="submit" class="w-full bg-[#25D366] hover:bg-[#128C7E] flex items-center justify-center gap-2 text-white font-bold py-4 px-4 rounded-md shadow-md transition duration-300 text-lg transform hover:-translate-y-1 cursor-pointer">
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Send via WhatsApp
      </button>
    </form>
  </div>
</dialog>

<script>
  // Modal toggle logic
  const modal = document.querySelector('#quote-modal') as HTMLDialogElement;
  const closeBtn = document.querySelector('#close-modal');
  const openBtns = document.querySelectorAll('.open-quote-modal');

  openBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      modal.showModal();
      document.body.style.overflow = 'hidden'; 
    });
  });

  closeBtn?.addEventListener('click', () => {
    modal.close();
    document.body.style.overflow = '';
  });

  modal?.addEventListener('click', (e) => {
    const dialogDimensions = modal.getBoundingClientRect();
    if (
      e.clientX < dialogDimensions.left ||
      e.clientX > dialogDimensions.right ||
      e.clientY < dialogDimensions.top ||
      e.clientY > dialogDimensions.bottom
    ) {
      modal.close();
      document.body.style.overflow = '';
    }
  });

  // --- NEW: WhatsApp Form Submission Logic ---
  const form = document.querySelector('#whatsapp-quote-form') as HTMLFormElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault(); // Stop the form from refreshing the page

    // Gather all data from the inputs
    const name = (document.getElementById('wa-name') as HTMLInputElement).value;
    const phone = (document.getElementById('wa-phone') as HTMLInputElement).value;
    const address1 = (document.getElementById('wa-address1') as HTMLInputElement).value;
    const address2 = (document.getElementById('wa-address2') as HTMLInputElement).value;
    const postcode = (document.getElementById('wa-postcode') as HTMLInputElement).value;
    const service = (document.getElementById('wa-service') as HTMLSelectElement).value;
    const date = (document.getElementById('wa-date') as HTMLSelectElement).value;
    const desc = (document.getElementById('wa-desc') as HTMLTextAreaElement).value;

    // Format the address cleanly
    const fullAddress = address2 ? `${address1}, ${address2}, ${postcode}` : `${address1}, ${postcode}`;

    // Construct the WhatsApp message with formatting (* makes text bold in WhatsApp)
    const message = `*New Quote Request (Abound Landscaping & Roofing)*
    
*Name:* ${name}
*Phone:* ${phone}
*Address:* ${fullAddress}

*Service Required:* ${service}
*Ideal Start Date:* ${date}

*Description:* ${desc}

_(I will send some photos of the project in my next message if applicable.)_`;

    // Abound's WhatsApp Number (no + or spaces needed for the API link)
    const whatsappNumber = "447864051249";
    
    // Encode the message so it works safely in a URL
    const encodedMessage = encodeURIComponent(message);
    
    // Build the final WhatsApp API URL
    const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodedMessage}`;

    // Open WhatsApp in a new tab
    window.open(whatsappUrl, '_blank');

    // Close the modal and reset the form
    modal.close();
    document.body.style.overflow = '';
    form.reset();
  });
</script>