---
// src/components/About.astro

export interface Props {
  previewMode?: boolean;
}

const { previewMode = false } = Astro.props;
---

<section id="about" class={`py-20 lg:py-28 ${previewMode ? 'bg-brand-light' : 'bg-white'}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      
      <div class="max-w-2xl">
        <div class="inline-flex items-center px-4 py-2 rounded-full bg-brand-green/10 text-brand-green font-semibold text-sm mb-6 border border-brand-green/20">
          Locally Owned & Operated
        </div>
        
        <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 tracking-tight mb-6">
          Passionate about transforming properties across <span class="text-brand-green">Kent, Sussex & Surrey.</span>
        </h2>
        
        <div class="prose prose-lg text-gray-700 mb-8">
          <p class="mb-4">
            At Abound Landscaping & Roofing, we believe your property's exterior should be a point of pride, not a source of stress. Based in Crowborough, we are a dedicated local business providing top-tier, reliable landscaping and roofing services to our community.
          </p>
          
          {previewMode ? (
            <p>
              Whether it's a full garden transformation, breathing new life into an old patio with a chemical wash, or essential roof and gutter maintenance, we treat every property as if it were our own.
            </p>
          ) : (
            <>
              <p class="mb-4">
                Whether it's a full garden transformation, breathing new life into an old patio with a chemical wash, or essential roof and gutter maintenance, we treat every property as if it were our own. We've built our reputation on turning up when we say we will, charging fair prices, and delivering results that speak for themselves.
              </p>
              <p class="mb-4">
                <strong>Our Promise:</strong> We deliver quality without compromise. From the moment you contact us for a free quote to the moment we clear away the last bit of debris, you'll experience a professional, friendly service that takes the hassle out of exterior maintenance.
              </p>
              <p>
                Fully insured and equipped for both residential and commercial projects, we are ready to bring your outdoor space back to life.
              </p>
            </>
          )}
        </div>

        <div class="mt-8">
          {previewMode ? (
            <a href="/about" class="inline-flex justify-center items-center px-8 py-3 border-2 border-brand-green text-base font-bold rounded-md text-brand-green bg-transparent hover:bg-brand-green hover:text-white transition-all duration-300">
              Read Our Full Story
            </a>
          ) : (
            <button class="open-quote-modal cursor-pointer inline-flex justify-center items-center px-8 py-4 border border-transparent text-lg font-bold rounded-md text-white bg-brand-accent hover:bg-brand-accent-hover shadow-lg transition-all duration-300 transform hover:-translate-y-1">
              Book Your Free Quote
            </button>
          )}
        </div>
      </div>

      <div class="relative w-full h-full min-h-[400px] rounded-2xl overflow-hidden shadow-xl border-4 border-white z-10">
        <img 
          src="/images/hero1.jpg" 
          alt="Abound Landscaping & Roofing transformation project" 
          class="absolute inset-0 w-full h-full object-cover"
        />
        
        <div class="absolute bottom-6 right-6 bg-white p-4 rounded-xl shadow-xl border border-gray-100 flex items-center gap-3">
          <div class="bg-brand-green/10 p-2 rounded-full text-brand-green">
             <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          </div>
          <div>
            <p class="text-xs text-gray-500 font-medium">Proudly Serving</p>
            <p class="text-base font-bold text-gray-900 leading-tight">Kent, Sussex<br/>& Surrey</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>