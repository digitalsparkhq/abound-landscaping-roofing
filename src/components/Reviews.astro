---
// src/components/Reviews.astro

// Easy-to-edit array for your customer reviews
const reviews = [
  {
    name: "Sarah T.",
    location: "Harlow",
    text: "HB Gardencare completely transformed our overgrown back garden. Professional, punctual, and left everything spotless. Highly recommend!",
    platform: "Facebook"
  },
  {
    name: "Mark W.",
    location: "Epping",
    text: "Reliable and fairly priced. They've been doing our regular lawn mowing and hedge trimming for months now, and the grass has never looked better.",
    platform: "Nextdoor"
  },
  {
    name: "Emma L.",
    location: "Harlow",
    text: "Fantastic service! They squared off my unruly front hedges perfectly and gave great advice on seasonal lawn care. A truly trustworthy local business.",
    platform: "Google"
  }
];
---

<section id="testimonials" class="py-20 lg:py-28 bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    
    <div class="absolute top-0 left-0 w-64 h-64 bg-brand-green/5 rounded-full blur-3xl -ml-32 -mt-32 pointer-events-none"></div>
    <div class="absolute bottom-0 right-0 w-80 h-80 bg-brand-accent/5 rounded-full blur-3xl -mr-40 -mb-40 pointer-events-none"></div>

    <div class="text-center max-w-3xl mx-auto mb-16 relative z-10">
      <div class="inline-flex items-center px-4 py-2 rounded-full bg-brand-green/10 text-brand-green font-semibold text-sm mb-4 border border-brand-green/20">
        Community Trusted
      </div>
      <h2 class="text-3xl md:text-4xl leading-tight font-extrabold text-gray-900 mb-6">
        Quality & Reliable <span class="text-brand-green">Service.</span>
      </h2>
      <p class="text-lg text-gray-600 mb-8">
        Don't just take our word for it. We take pride in our reputation across Harlow and the surrounding areas.
      </p>

      <div class="flex flex-wrap justify-center items-center gap-6 md:gap-12">
        <div class="flex items-center gap-3">
          <div class="bg-blue-600 text-white p-2 rounded-full">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M22.675 0H1.325C.593 0 0 .593 0 1.325v21.351C0 23.407.593 24 1.325 24H12.82v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116c.73 0 1.323-.593 1.323-1.325V1.325C24 .593 23.407 0 22.675 0z"/></svg>
          </div>
          <div class="text-left">
            <div class="flex text-yellow-400 text-sm">
              ★★★★★
            </div>
            <p class="text-sm font-bold text-gray-900 leading-tight">5.0 Rating</p>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <div class="bg-[#00b246] text-white p-2 rounded-full">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12.015 1.942a.852.852 0 0 0-.6.236L3.926 9.664a.81.81 0 0 0 .57 1.385h.923v9.846c0 .641.513 1.154 1.154 1.154h10.846c.641 0 1.154-.513 1.154-1.154V11.05h.923a.81.81 0 0 0 .57-1.385l-7.489-7.486a.852.852 0 0 0-.562-.237zm0 2.278l5.441 5.438h-.697a.81.81 0 0 0-.81.81v8.423h-7.89V10.468a.81.81 0 0 0-.81-.81h-.697l5.463-5.438zM12 11.23a2.923 2.923 0 1 0 0 5.847 2.923 2.923 0 0 0 0-5.846zm0 1.62a1.303 1.303 0 1 1 0 2.607 1.303 1.303 0 0 1 0-2.606z"/></svg>
          </div>
          <div class="text-left">
            <p class="text-sm font-bold text-gray-900 leading-tight">Local Favorite</p>
            <p class="text-xs text-gray-500">Nextdoor Community</p>
          </div>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative z-10">
      {reviews.map((review) => (
        <div class="bg-brand-light rounded-2xl p-8 shadow-sm border border-brand-green/10 relative hover:shadow-lg transition-shadow duration-300 flex flex-col justify-between h-full">
          
          <svg class="absolute top-6 left-6 w-16 h-16 text-brand-green/10 -z-0" fill="currentColor" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.896 3.456-8.352 9.12-8.352 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z" />
          </svg>

          <div class="relative z-10">
            <div class="flex text-brand-accent mb-4">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            </div>
            
            <p class="text-gray-700 leading-relaxed mb-6 italic">
              "{review.text}"
            </p>
          </div>

          <div class="mt-auto flex items-center justify-between border-t border-gray-200/60 pt-4 relative z-10">
            <div>
              <p class="font-bold text-gray-900">{review.name}</p>
              <p class="text-sm text-gray-500">{review.location}</p>
            </div>
            <span class="text-xs font-semibold text-brand-green bg-brand-green/10 px-2 py-1 rounded">
              via {review.platform}
            </span>
          </div>
          
        </div>
      ))}
    </div>

    <div class="mt-16 text-center">
      <p class="text-gray-600 mb-6 font-medium">Ready to see the difference for yourself?</p>
      <button class="open-quote-modal cursor-pointer inline-flex justify-center items-center px-8 py-4 text-lg font-bold rounded-md text-white bg-brand-accent hover:bg-brand-accent-hover shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
        Book Your Free Garden Visit
      </button>
    </div>

  </div>
</section>