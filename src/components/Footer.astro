---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="bg-brand-green-dark text-white pt-16 pb-8 border-t-[6px] border-brand-accent">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16 text-center md:text-left">
      
      <div class="flex flex-col items-center md:items-start">
        <a href="/" class="inline-block mb-6 bg-white p-2 rounded-lg">
          <img src="/images/logo.jpg" alt="HB Gardencare Logo" class="h-16 w-auto object-contain" />
        </a>
        <p class="text-brand-light/80 leading-relaxed mb-6">
          Expert garden care, regular maintenance, and reliable service across Harlow, Essex, and surrounding areas. Let us make your garden thrive.
        </p>
        <div class="flex space-x-4 justify-center md:justify-start">
          <a href="https://www.facebook.com/HBGroundsGardenCare" target="_blank" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-white hover:bg-brand-accent transition-colors" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M22.675 0H1.325C.593 0 0 .593 0 1.325v21.351C0 23.407.593 24 1.325 24H12.82v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116c.73 0 1.323-.593 1.323-1.325V1.325C24 .593 23.407 0 22.675 0z"/></svg>
          </a>
          <a href="https://wa.me/447588777275" target="_blank" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center text-white hover:bg-brand-accent transition-colors" aria-label="WhatsApp">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </a>
        </div>
      </div>

      <div class="flex flex-col items-center md:items-start">
        <h3 class="text-lg font-bold mb-6 text-white">Quick Links</h3>
        <ul class="space-y-4 flex flex-col items-center md:items-start">
          <li><a href="/#home" class="w-fit inline-flex items-center text-brand-light/80 hover:text-brand-accent transition-colors"><span class="mr-2 text-brand-accent">›</span> Home</a></li>
          <li><a href="/about" class="w-fit inline-flex items-center text-brand-light/80 hover:text-brand-accent transition-colors"><span class="mr-2 text-brand-accent">›</span> About Us</a></li>
          <li><a href="/#gallery" class="w-fit inline-flex items-center text-brand-light/80 hover:text-brand-accent transition-colors"><span class="mr-2 text-brand-accent">›</span> Gallery</a></li>
          <li><a href="/#testimonials" class="w-fit inline-flex items-center text-brand-light/80 hover:text-brand-accent transition-colors"><span class="mr-2 text-brand-accent">›</span> Reviews</a></li>
          <li><a href="/contact" class="w-fit inline-flex items-center text-brand-light/80 hover:text-brand-accent transition-colors"><span class="mr-2 text-brand-accent">›</span> Contact</a></li>
        </ul>
      </div>

      <div class="flex flex-col items-center md:items-start">
        <h3 class="text-lg font-bold mb-6 text-white">Our Services</h3>
        <ul class="space-y-4 flex flex-col items-center md:items-start">
          <li><a href="/#services" class="w-fit inline-flex items-center text-brand-light/80 hover:text-brand-accent transition-colors"><span class="mr-2 text-brand-accent">›</span> Lawn Mowing & Care</a></li>
          <li><a href="/#services" class="w-fit inline-flex items-center text-brand-light/80 hover:text-brand-accent transition-colors"><span class="mr-2 text-brand-accent">›</span> Hedge Trimming</a></li>
          <li><a href="/#services" class="w-fit inline-flex items-center text-brand-light/80 hover:text-brand-accent transition-colors"><span class="mr-2 text-brand-accent">›</span> Garden Maintenance</a></li>
          <li><a href="/#services" class="w-fit inline-flex items-center text-brand-light/80 hover:text-brand-accent transition-colors"><span class="mr-2 text-brand-accent">›</span> Seasonal Clean-ups</a></li>
        </ul>
      </div>

      <div class="flex flex-col items-center md:items-start">
        <h3 class="text-lg font-bold mb-6 text-white">Get in Touch</h3>
        <ul class="space-y-4 flex flex-col items-center md:items-start w-full">
          <li class="flex items-start justify-center md:justify-start w-full text-brand-light/80">
            <svg class="w-5 h-5 mr-3 mt-0.5 flex-shrink-0 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            <a href="tel:07588777275" class="w-fit text-left hover:text-white transition-colors">07588 777275</a>
          </li>
          <li class="flex items-start justify-center md:justify-start w-full text-brand-light/80">
            <svg class="w-5 h-5 mr-3 mt-0.5 flex-shrink-0 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            <a href="mailto:info@hbgardencare.co.uk" class="w-fit text-left hover:text-white transition-colors">info@hbgardencare.co.uk</a>
          </li>
          <li class="flex items-start justify-center md:justify-start w-full text-brand-light/80">
            <svg class="w-5 h-5 mr-3 mt-0.5 flex-shrink-0 text-brand-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <span class="text-left">Harlow, Essex <br class="hidden md:block"/>& Surrounding Areas</span>
          </li>
        </ul>
      </div>

    </div>

    <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-brand-light/60 text-center md:text-left">
        &copy; {currentYear} HB Grounds/Garden Care. All rights reserved.
      </p>
      
      <p class="text-sm text-brand-light/60 text-center md:text-right">
        Design by <a href="https://digitalsparkhq.com/" target="_blank" rel="noopener noreferrer" class="text-brand-light/60 hover:text-white transition-colors font-medium">Digital Spark HQ</a>
      </p>
    </div>

  </div>
</footer>