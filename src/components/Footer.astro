          <li><a href="/contact" class="w-fit inline-flex items-center text-brand-light/80 hover:text-brand-accent transition-colors"><span class="mr-2 text-brand-accent">›</span> Contact</a></li>
        </ul>
      </div>

      <div class="flex flex-col items-center md:items-start">
        <h3 class="text-lg font-bold mb-6 text-white">Our Services</h3>
        <ul class="space-y-4 flex flex-col items-center md:items-start">
          <li><a href="/#services" class="w-fit inline-flex items-center text-brand-light/80 hover:text-brand-accent transition-colors"><span class="mr-2 text-brand-accent">›</span> Roof & Gutter Cleaning</a></li>
          <li><a href="/#services" class="w-fit inline-flex items-center text-brand-light/80 hover:text-brand-accent transition-colors"><span class="mr-2 text-brand-accent">›</span> Patio Restoration</a></li>
