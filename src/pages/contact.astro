---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us | Abound Landscaping & Roofing">
  
  <section class="bg-brand-green overflow-hidden relative flex flex-col justify-center items-center" style="min-height: 300px;">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 24px 24px;"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center w-full">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-tight mb-4">
        Contact Us
      </h1>
      <p class="text-xl text-brand-light/90 max-w-2xl mx-auto">
        Ready to transform your property? Get in touch for a free, no-obligation quote.
      </p>
    </div>
  </section>

  <section class="py-20 lg:py-28 bg-brand-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        
        <div class="pt-4">
          <div class="inline-flex items-center px-4 py-2 rounded-full bg-brand-green/10 text-brand-green font-semibold text-sm mb-6 border border-brand-green/20">
            We're Here to Help
          </div>
          <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-6 leading-tight">
            Let's discuss your exterior project.
          </h2>
          <p class="text-lg text-gray-600 mb-12">
            Whether you need a gutter clean, a patio restoration, or a full garden transformation, we are ready to work. Fill out the form, or reach out to us directly.
          </p>

          <div class="space-y-10">
            <div class="flex items-start gap-6">
              <div class="flex-shrink-0 w-16 h-16 bg-white rounded-2xl flex items-center justify-center text-brand-green shadow-md border border-brand-green/10">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              </div>
              <div class="pt-1">
                <h3 class="text-xl font-bold text-gray-900">Call or WhatsApp</h3>
                <p class="mt-1 text-gray-500">Mon - Sat, 8am - 6pm</p>
                <a href="tel:07864051249" class="mt-2 text-xl font-bold text-brand-green hover:text-brand-accent transition inline-block">07864 051249</a>
              </div>
            </div>

            <div class="flex items-start gap-6">
              <div class="flex-shrink-0 w-16 h-16 bg-white rounded-2xl flex items-center justify-center text-brand-green shadow-md border border-brand-green/10">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <div class="pt-1">
                <h3 class="text-xl font-bold text-gray-900">Email Us</h3>
                <p class="mt-1 text-gray-500">We aim to reply within 24 hours.</p>
                <a href="mailto:aboundlandscaping@outlook.com" class="mt-2 text-lg font-bold text-brand-green hover:text-brand-accent transition inline-block">aboundlandscaping@outlook.com</a>
              </div>
            </div>

            <div class="flex items-start gap-6">
              <div class="flex-shrink-0 w-16 h-16 bg-white rounded-2xl flex items-center justify-center text-brand-green shadow-md border border-brand-green/10">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
              </div>
              <div class="pt-1">
                <h3 class="text-xl font-bold text-gray-900">Service Area</h3>
                <p class="mt-1 text-gray-500 leading-relaxed max-w-sm">Based in Crowborough, proudly serving Kent, Sussex, Surrey, and surrounding areas.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-white p-8 sm:p-10 rounded-2xl shadow-xl border border-gray-100 relative overflow-hidden">
          <div class="absolute top-0 left-0 w-full h-2 bg-brand-green"></div>
          
          <h3 class="text-2xl font-bold text-brand-green mb-2 mt-2">Request a Free Quote</h3>
          <p class="text-sm text-gray-500 mb-8">Submitting this form will open a direct WhatsApp chat with our team.</p>
          
          <form id="contact-page-form" class="space-y-8">
            
            <div class="bg-gray-50/50 p-6 rounded-xl border border-gray-100">
              <h4 class="text-sm font-bold text-gray-800 uppercase tracking-wider mb-5 flex items-center gap-2">
                <svg class="w-4 h-4 text-brand-accent" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path></svg>
                Your Details
              </h4>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-x-5 gap-y-6">
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1.5">Name</label>
                  <input type="text" id="cp-name" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green focus:ring-brand-green p-3 border bg-gray-50 focus:bg-white transition-colors" required />
                </div>
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1.5">Phone Number</label>
                  <input type="tel" id="cp-phone" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green focus:ring-brand-green p-3 border bg-gray-50 focus:bg-white transition-colors" required />
                </div>
                <div class="md:col-span-2">
                  <label class="block text-sm font-semibold text-gray-700 mb-1.5">Address Line 1</label>
                  <input type="text" id="cp-address1" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green focus:ring-brand-green p-3 border bg-gray-50 focus:bg-white transition-colors" required />
                </div>
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1.5">Address Line 2 <span class="text-gray-400 font-normal">(Optional)</span></label>
                  <input type="text" id="cp-address2" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green focus:ring-brand-green p-3 border bg-gray-50 focus:bg-white transition-colors" />
                </div>
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1.5">Postal Code</label>
                  <input type="text" id="cp-postcode" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green focus:ring-brand-green p-3 border bg-gray-50 focus:bg-white transition-colors" required />
                </div>
              </div>
            </div>

            <div class="bg-gray-50/50 p-6 rounded-xl border border-gray-100">
              <h4 class="text-sm font-bold text-gray-800 uppercase tracking-wider mb-5 flex items-center gap-2">
                <svg class="w-4 h-4 text-brand-accent" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"></path></svg>
                Project Specifications
              </h4>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-x-5 gap-y-6">
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1.5">Service Required</label>
                  <select id="cp-service" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green focus:ring-brand-green p-3 border bg-gray-50 focus:bg-white transition-colors cursor-pointer">
                    <option>Roof & Gutter Cleaning</option>
                    <option>Patio Restoration / Jet Wash</option>
                    <option>Garden Transformation</option>
                    <option>Fencing & Gates</option>
                    <option>Turfing & Lawns</option>
                    <option>Other / 10% New Customer Discount</option>
                  </select>
                </div>
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1.5">Ideal Start Date</label>
                  <select id="cp-date" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green focus:ring-brand-green p-3 border bg-gray-50 focus:bg-white transition-colors cursor-pointer">
                    <option>As soon as possible</option>
                    <option>Within the next week</option>
                    <option>Within the next month</option>
                    <option>Flexible</option>
                  </select>
                </div>
                <div class="md:col-span-2">
                  <label class="block text-sm font-semibold text-gray-700 mb-1.5">Project Description</label>
                  <textarea id="cp-desc" rows="4" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-brand-green focus:ring-brand-green p-3 border bg-gray-50 focus:bg-white transition-colors" placeholder="Tell us about your property or issue..."></textarea>
                </div>
              </div>
            </div>

            <div class="pt-4">
              <button type="submit" class="w-full flex justify-center items-center gap-2 bg-[#25D366] hover:bg-[#128C7E] text-white font-bold py-4 px-4 rounded-md shadow-lg transition duration-300 text-xl transform hover:-translate-y-1 cursor-pointer">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                Send via WhatsApp
              </button>
            </div>
            
          </form>
        </div>

      </div>
    </div>
  </section>

</Layout>

<script>
  // WhatsApp Form Submission Logic specifically for the Contact Page
  const contactPageForm = document.querySelector('#contact-page-form') as HTMLFormElement;

  contactPageForm?.addEventListener('submit', (e) => {
    e.preventDefault(); 

    // Gather data using unique IDs for this page to avoid clashes with QuoteModal
    const name = (document.getElementById('cp-name') as HTMLInputElement).value;
    const phone = (document.getElementById('cp-phone') as HTMLInputElement).value;
    const address1 = (document.getElementById('cp-address1') as HTMLInputElement).value;
    const address2 = (document.getElementById('cp-address2') as HTMLInputElement).value;
    const postcode = (document.getElementById('cp-postcode') as HTMLInputElement).value;
    const service = (document.getElementById('cp-service') as HTMLSelectElement).value;
    const date = (document.getElementById('cp-date') as HTMLSelectElement).value;
    const desc = (document.getElementById('cp-desc') as HTMLTextAreaElement).value;

    const fullAddress = address2 ? `${address1}, ${address2}, ${postcode}` : `${address1}, ${postcode}`;

    const message = `*New Quote Request (Abound Landscaping & Roofing)*
    
*Name:* ${name}
*Phone:* ${phone}
*Address:* ${fullAddress}

*Service Required:* ${service}
*Ideal Start Date:* ${date}

*Description:* ${desc}

_(I will send some photos of the project in my next message if applicable.)_`;

    const whatsappNumber = "447864051249";
    const encodedMessage = encodeURIComponent(message);
    const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodedMessage}`;

    window.open(whatsappUrl, '_blank');
    contactPageForm.reset();
  });
</script>