---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found | Abound Landscaping & Roofing" noindex={true}>
  
  <section class="bg-brand-light py-20 lg:py-32 min-h-[70vh] flex flex-col justify-center items-center text-center px-4 relative overflow-hidden">
    
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-brand-green/5 rounded-full blur-3xl -z-10 pointer-events-none"></div>

    <div class="max-w-2xl mx-auto relative z-10">
      
      <div class="text-brand-green font-extrabold text-8xl md:text-9xl tracking-tight mb-2 opacity-20">
        404
      </div>
      
      <h1 class="text-3xl md:text-5xl font-extrabold text-gray-900 mb-6 leading-tight">
        Oops! Looks like this path hasn't been paved yet.
      </h1>
      
      <p class="text-lg text-gray-600 mb-10 leading-relaxed max-w-lg mx-auto">
        We can't seem to find the page you're looking for. It might have been moved, deleted, or perhaps the URL was mistyped.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="inline-flex justify-center items-center px-8 py-4 text-lg font-bold rounded-md text-white bg-brand-accent hover:bg-brand-accent-hover shadow-lg transition-all duration-300 transform hover:-translate-y-1">
          Back to Homepage
        </a>
        <a href="/contact" class="inline-flex justify-center items-center px-8 py-4 border-2 border-brand-green text-lg font-bold rounded-md text-brand-green bg-transparent hover:bg-brand-green hover:text-white transition-all duration-300">
          Contact Us
        </a>
      </div>
      
    </div>
  </section>

</Layout>