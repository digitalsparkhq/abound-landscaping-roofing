---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
import AboutSection from '../components/About.astro';

const values = [
  {
    title: "Unwavering Reliability",
    description: "We turn up when we say we will. No chasing, no excuses. Just consistent, dependable landscaping and roofing services you can trust.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>`
  },
  {
    title: "Meticulous Quality",
    description: "From seamless patio repointing to precise roof repairs and garden transformations, we take immense pride in our workmanship. We don't cut corners.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path></svg>`
  },
  {
    title: "Local & Proud",
    description: "We are a locally owned and operated business based in Crowborough, proudly serving our communities across Kent, Sussex, and Surrey.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>`
  }
];
---

<Layout title="About Us | Abound Landscaping & Roofing">
  
  <section class="bg-brand-green overflow-hidden relative flex flex-col justify-center items-center" style="min-height: 300px;">
    <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(#ffffff 1px, transparent 1px); background-size: 24px 24px;"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-center w-full">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-tight mb-4">
        Our Story
      </h1>
      <p class="text-xl text-brand-light/90 max-w-2xl mx-auto">
        Your trusted local experts in Kent, Sussex & Surrey. We're passionate about transforming your property's exterior.
      </p>
    </div>
  </section>

  <div class="bg-white">
    <AboutSection />
  </div>

  <section class="py-20 lg:py-28 bg-brand-light border-t border-brand-green/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 tracking-tight mb-4">
          Why choose <span class="text-brand-green">Abound Landscaping?</span>
        </h2>
        <p class="text-lg text-gray-600">
          Finding a good tradesman shouldn't be hard. We built this business on three core principles to ensure you get the best service possible.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {values.map((value) => (
          <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 hover:shadow-md transition-shadow duration-300">
            <div class="w-14 h-14 rounded-xl bg-brand-green/10 text-brand-green flex items-center justify-center mb-6">
              <Fragment set:html={value.icon} />
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">{value.title}</h3>
            <p class="text-gray-600 leading-relaxed">
              {value.description}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-gray-900 mb-6">Let's get your exterior sorted.</h2>
      <p class="text-lg text-gray-600 mb-8">
        Ready to transform your property? Get in touch today for a free, no-obligation quote on your landscaping or roofing project.
      </p>
      <button class="open-quote-modal cursor-pointer inline-flex justify-center items-center px-8 py-4 border border-transparent text-lg font-bold rounded-md text-white bg-brand-accent hover:bg-brand-accent-hover shadow-lg transition-all duration-300 transform hover:-translate-y-1">
        Request a Free Quote
      </button>
    </div>
  </section>

</Layout>